{
  "name": "orbithud",
  "version": "1.2.1",
  "description": "OrbitHUD — Zero-Gravity Glassmorphic AI Usage & Quota HUD for Google Antigravity, Claude Code, and OpenAI Codex CLI (macOS, Windows, Linux)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/quotaFetcher.test.js",
    "dist:win": "electron-builder --win --x64 --arm64",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:all": "electron-builder -mwl"
  },
  "keywords": [
    "antigravity",
    "claude-code",
    "codex",
    "multi-provider",
    "ai-coding",
    "usage",
    "quota",
    "hud",
    "widget",
    "windows",
    "linux",
    "macos",
    "electron"
  ],
  "author": {
    "name": "Mojtaba Afraz",
    "email": "mojtaba.afraz@users.noreply.github.com"
  },
  "homepage": "https://github.com/mojtaba-afraz/OrbitHUD",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.orbithud.antigravity",
    "productName": "OrbitHUD",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Mojtaba Afraz <mojtaba.afraz@users.noreply.github.com>"
    }
  }
}
